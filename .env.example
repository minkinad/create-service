NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=my-service
SERVICE_VERSION=1.0.0
# Empty disables cross-origin access; use * or an explicit comma-separated allowlist.
CORS_ORIGINS=
TRUST_PROXY=false
# Leave unset to enable docs outside production only.
# DOCS_ENABLED=true
METRICS_ENABLED=true
RATE_LIMIT_MAX=100
READINESS_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000
